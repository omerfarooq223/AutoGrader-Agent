# ── AutoGrader Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.

GROQ_API_KEY=your-api-key-here
GEMINI_API_KEY=your-gemini-key-here
MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash

# Enable image extraction only when needed (costs extra API quota)
EXTRACT_IMAGES=False

# Max parallel grading API calls (keep ≤ 5 to respect rate limits)
MAX_CONCURRENT_GRADES=4

# Retry attempts for failed API calls
MAX_RETRIES=3

# Token controls (lower values reduce quota usage and increase capacity)
GRADING_MAX_OUTPUT_TOKENS=768

# Long submissions are processed completely in overlapping chunks instead of being truncated.
# Set CHUNKED_GRADING_CHAR_LIMIT=0 to disable chunked grading.
CHUNKED_GRADING_CHAR_LIMIT=45000
CHUNKED_GRADING_CHUNK_CHARS=22000
CHUNKED_GRADING_OVERLAP_CHARS=1200
CHUNKED_EVIDENCE_AGGREGATION_CHAR_LIMIT=36000
CHUNKED_EVIDENCE_GROUP_SIZE=8

# Grading scale
TOTAL_MARKS=100
PASS_THRESHOLD=50

# Plagiarism cosine-similarity threshold (0.0 – 1.0)
SIMILARITY_THRESHOLD=0.65

# Output filenames
OUTPUT_FILENAME=grading_report.xlsx
CACHE_FILENAME=.grading_cache.json
